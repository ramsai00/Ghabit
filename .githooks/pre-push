#!/usr/bin/env sh
# Prevent accidental direct push to main/master branches.
# Use a feature branch and open a pull request instead.

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
    echo ""
    echo "ERROR: direct push to '$remote_ref' is blocked."
    echo "Please push to a feature branch and merge through PR instead."
    echo ""
    exit 1
  fi
done

exit 0
